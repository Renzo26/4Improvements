# Banco de dados — Supabase (Session Pooler, porta 5432, compatível com IPv4)
# Formato: postgresql+asyncpg://postgres.<PROJECT_REF>:<SENHA>@aws-1-<REGIAO>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:SUA_SENHA@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# App
APP_ENV=development
APP_PORT=8080

# SLA — minutos para o primeiro contacto
SLA_MINUTES=30

# CORS — origem do frontend
CORS_ORIGINS=http://localhost:5173
